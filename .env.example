# ==============================================================================
# Live Location Tracker - Environment Configuration Template
# Copy this file to .env and configure appropriate values for your deployment.
# NEVER commit the actual .env file or real credentials to source control.
# ==============================================================================

# Application Environment ('development' or 'production')
NODE_ENV=development

# Server Port (default: 6589)
PORT=6589

# Admin Authentication Credentials
# In production, use a strong, unpredictable password (minimum 8 characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production

# Cryptographically Secure Session Secret
# Generate a strong 64+ character random string (e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET=generate_a_64_character_hex_random_secret_here_for_production_deployments

# Session Expiration in Hours (default: 12 hours)
SESSION_TTL_HOURS=12

# Reverse Proxy Trust Settings
# Set to 'true' or a specific proxy IP range (e.g., 'loopback') if deployed behind Nginx, Caddy, or Cloudflare
TRUST_PROXY=false

# Cloudflare Tunnel Integration
# Set to 'false' if hosting with your own domain/SSL or in private corporate network
ENABLE_TUNNEL=true

# Private Storage Directory (defaults to ./storage/uploads)
# Must be outside any publicly served static path
UPLOAD_DIR=./storage/uploads

# Storage Safeguards
# Maximum allowed disk space usage for uploaded photos in Megabytes (default: 500)
MAX_STORAGE_MB=500

# Per-photo upload size limit in Megabytes (default: 5)
MAX_UPLOAD_SIZE_MB=5

# Maximum number of photos allowed in a single upload batch (default: 10)
MAX_PHOTOS_PER_BATCH=10

# Upload Rate Limiting (maximum upload requests per IP per minute window)
RATE_LIMIT_MAX=15
RATE_LIMIT_WINDOW_MS=60000
